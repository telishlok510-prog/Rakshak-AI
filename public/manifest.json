{
  "name": "Rakshak AI",
  "short_name": "Rakshak AI",
  "description": "AI-powered scam detection to protect first-time digital banking users.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#1a3c6e",
  "theme_color": "##1a3c6e",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "photo",
          "accept": ["image/*"]
        },
        {
          "name": "recording",
          "accept": ["audio/*", ".mp3", ".m4a", ".wav", ".ogg", ".aac", ".3gp", ".amr"]
        }
      ]
    }
  }
}