# Copy this file to .env.local and add your key.
# The app works in DEMO MODE (heuristic detection) without a key,
# but AI-powered explanations require the Gemini API (free, no credit card).

# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model (defaults to gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite

# ============================================================================
# NEW: Location-Based Scam Alert System (Push Notifications)
# ============================================================================

# VAPID Keys for Web Push Notifications
# Generate with: npx web-push generate-vapid-keys
# Or with Node.js: const webpush = require('web-push'); console.log(webpush.generateVAPIDKeys());

# Public key (exposed to client via NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Private key (server-side only, never exposed to client)
VAPID_PRIVATE_KEY=

# Subject (usually mailto:youremail@example.com or your site URL)
VAPID_SUBJECT=mailto:youremail@example.com

# ============================================================================
# Vercel KV (Redis) for Alert System Storage
# ============================================================================
# These are automatically set by Vercel when you add KV from the dashboard.
# No manual configuration needed - just add Vercel KV via:
# Project Settings → Storage → Create Database → KV (Redis)

# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
