# Copy this file to .env.local and add your key.
# The app works in DEMO MODE (heuristic detection) without a key,
# but AI-powered explanations require the Gemini API (free, no credit card).

# ============================================================================
# Gemini API Keys (Google AI)
# ============================================================================
# Get free keys at: https://aistudio.google.com/apikey

# Primary keys for SMS/URL/UPI analysis and scam alerts (multi-key rotation)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Dedicated key for ChatAssistant (separate quota for enhanced capabilities)
# This allows ChatAssistant to have its own 15 req/min, 1000 req/day quota
# Falls back to GEMINI_API_KEY_1/2/3 if not set
GEMINI_CHAT_API_KEY=

# Backward compatibility (single key, legacy)
GEMINI_API_KEY=

# Optional: override the model (defaults to gemini-flash-latest)
# GEMINI_MODEL=gemini-2.0-flash-exp

# ============================================================================
# Location-Based Scam Alert System (Push Notifications)
# ============================================================================

# VAPID Keys for Web Push Notifications
# Generate with: npx web-push generate-vapid-keys
# Or with Node.js: const webpush = require('web-push'); console.log(webpush.generateVAPIDKeys());

# Public key (exposed to client via NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Private key (server-side only, never exposed to client)
VAPID_PRIVATE_KEY=

# Subject (usually mailto:youremail@example.com or your site URL)
VAPID_SUBJECT=mailto:youremail@example.com

# ============================================================================
# Upstash Redis (Database for Alert System)
# ============================================================================
# Get free Redis database at: https://upstash.com
# Create a Redis database and copy the REST API credentials

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================================
# Admin Access (Market Alerts Dashboard)
# ============================================================================
# Password for accessing /admin/market-alerts to broadcast scam alerts

ADMIN_PASSWORD=
